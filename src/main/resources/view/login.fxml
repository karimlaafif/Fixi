<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import ma.fixi.view.component.PasswordInput?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Écran de connexion. Contrôleur : ma.fixi.controller.LoginController -->
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ma.fixi.controller.LoginController" spacing="28">
    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

    <fx:include source="brand-panel.fxml"/>

    <StackPane HBox.hgrow="ALWAYS" minWidth="440">
        <VBox maxWidth="420" spacing="0" alignment="CENTER_LEFT">

            <Label text="Bon retour !" styleClass="auth-form-title"/>
            <Label text="Connectez-vous à votre compte Fixi." styleClass="page-subtitle">
                <VBox.margin><Insets top="6" bottom="28"/></VBox.margin>
            </Label>

            <HBox fx:id="errorBox" styleClass="form-alert" spacing="10" alignment="CENTER_LEFT" visible="false" managed="false">
                <FontIcon iconLiteral="fth-alert-circle" iconSize="17" styleClass="icon"/>
                <Label fx:id="errorLabel" wrapText="true"/>
                <VBox.margin><Insets bottom="18"/></VBox.margin>
            </HBox>

            <Label text="E-mail" styleClass="form-label" labelFor="$emailField"/>
            <StackPane>
                <VBox.margin><Insets top="8" bottom="18"/></VBox.margin>
                <TextField fx:id="emailField" promptText="nom@exemple.ma" styleClass="field-with-icon"/>
                <FontIcon iconLiteral="fth-mail" iconSize="17" styleClass="icon-muted" mouseTransparent="true"
                          StackPane.alignment="CENTER_LEFT">
                    <StackPane.margin><Insets left="14"/></StackPane.margin>
                </FontIcon>
            </StackPane>

            <Label text="Mot de passe" styleClass="form-label"/>
            <PasswordInput fx:id="passwordField" promptText="Votre mot de passe">
                <VBox.margin><Insets top="8" bottom="26"/></VBox.margin>
            </PasswordInput>

            <Button fx:id="loginButton" text="Se connecter" styleClass="btn-primary,btn-large" maxWidth="Infinity"
                    defaultButton="true" onAction="#onLogin" contentDisplay="RIGHT" graphicTextGap="10">
                <graphic><FontIcon iconLiteral="fth-arrow-right" iconSize="18" styleClass="icon"/></graphic>
            </Button>

            <HBox styleClass="or-divider" alignment="CENTER" spacing="14">
                <VBox.margin><Insets top="26" bottom="16"/></VBox.margin>
                <Region styleClass="divider" HBox.hgrow="ALWAYS"/>
                <Label text="Pas encore de compte ?"/>
                <Region styleClass="divider" HBox.hgrow="ALWAYS"/>
            </HBox>

            <Button text="Créer un compte" styleClass="btn-secondary,btn-large" maxWidth="Infinity" onAction="#onRegister"/>

            <VBox fx:id="demoBox" styleClass="demo-box" spacing="8" visible="false" managed="false">
                <VBox.margin><Insets top="28"/></VBox.margin>
                <Label text="Mode démonstration : cliquez un compte pour le remplir (mot de passe fixi1234)."
                       styleClass="text-subtle" wrapText="true"/>
                <FlowPane hgap="8" vgap="8">
                    <Button text="Client" styleClass="demo-account" onAction="#fillClient"/>
                    <Button text="Artisan" styleClass="demo-account" onAction="#fillArtisan"/>
                    <Button text="Administrateur" styleClass="demo-account" onAction="#fillAdmin"/>
                </FlowPane>
            </VBox>
        </VBox>
    </StackPane>
</HBox>
