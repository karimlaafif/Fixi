<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- CRUD des métiers (fonctionnalité CRUD de l'itération 1).
     Contrôleur : ma.fixi.controller.AdminTradesController -->
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ma.fixi.controller.AdminTradesController" styleClass="page-content" spacing="24">

    <VBox spacing="14" HBox.hgrow="ALWAYS">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <StackPane HBox.hgrow="ALWAYS" maxWidth="360">
                <TextField fx:id="filterField" promptText="Filtrer les métiers…" styleClass="field-with-icon"/>
                <FontIcon iconLiteral="fth-search" iconSize="16" styleClass="icon-muted" mouseTransparent="true"
                          StackPane.alignment="CENTER_LEFT">
                    <StackPane.margin><Insets left="15"/></StackPane.margin>
                </FontIcon>
            </StackPane>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel" styleClass="text-muted"/>
        </HBox>

        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nameFrColumn" text="NOM (FRANÇAIS)" prefWidth="260"/>
                <TableColumn fx:id="nameArColumn" text="NOM (ARABE)" prefWidth="220"/>
                <TableColumn fx:id="activeColumn" text="STATUT" prefWidth="140"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
        </TableView>
    </VBox>

    <VBox styleClass="card" spacing="0" minWidth="340" maxWidth="360" maxHeight="-Infinity">
        <padding><Insets top="22" right="24" bottom="22" left="24"/></padding>
        <Label fx:id="formTitle" styleClass="h2"/>
        <Label fx:id="formHint" styleClass="text-subtle" wrapText="true">
            <VBox.margin><Insets top="4" bottom="18"/></VBox.margin>
        </Label>

        <HBox spacing="3"><Label text="Nom en français" styleClass="form-label"/><Label text="*" styleClass="text-danger"/></HBox>
        <TextField fx:id="nameFrField" promptText="Ex. Plomberie">
            <VBox.margin><Insets top="8"/></VBox.margin>
        </TextField>
        <Label fx:id="nameFrError" styleClass="field-error" visible="false" managed="false"/>

        <HBox spacing="3">
            <VBox.margin><Insets top="16"/></VBox.margin>
            <Label text="Nom en arabe" styleClass="form-label"/><Label text="*" styleClass="text-danger"/>
        </HBox>
        <TextField fx:id="nameArField" promptText="مثال: سباكة" nodeOrientation="RIGHT_TO_LEFT" styleClass="rtl-field">
            <VBox.margin><Insets top="8"/></VBox.margin>
        </TextField>
        <Label fx:id="nameArError" styleClass="field-error" visible="false" managed="false"/>

        <CheckBox fx:id="activeCheck" text="Proposé aux clients (actif)" selected="true">
            <VBox.margin><Insets top="18"/></VBox.margin>
        </CheckBox>

        <HBox spacing="10">
            <VBox.margin><Insets top="24"/></VBox.margin>
            <Button fx:id="saveButton" styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onSave"/>
            <Button text="Vider" styleClass="btn-ghost" onAction="#onClear"/>
        </HBox>
        <Button fx:id="deleteButton" text="Supprimer ce métier" styleClass="btn-danger-outline" maxWidth="Infinity"
                onAction="#onDelete" visible="false" managed="false">
            <graphic><FontIcon iconLiteral="fth-trash-2" iconSize="15" styleClass="icon"/></graphic>
            <VBox.margin><Insets top="10"/></VBox.margin>
        </Button>
    </VBox>
</HBox>
