<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Tableau de bord artisan. Contrôleur : ma.fixi.controller.ArtisanDashboardController -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ma.fixi.controller.ArtisanDashboardController" fitToWidth="true" hbarPolicy="NEVER">
    <VBox styleClass="page-content" spacing="22">

        <HBox spacing="18">
            <!-- Bannière d'accueil -->
            <HBox styleClass="card-hero" spacing="12" alignment="BOTTOM_LEFT" HBox.hgrow="ALWAYS"
                  style="-fx-padding: 0 18 0 28;" minWidth="420">
                <VBox spacing="14" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                    <padding><Insets top="24" bottom="24"/></padding>
                    <Label text="Fixi" styleClass="hero-title" style="-fx-font-size: 34px;"/>
                    <Label fx:id="bannerText" styleClass="auth-brand-lead" wrapText="true" maxWidth="340"/>
                    <Button text="Voir mes demandes" styleClass="btn-primary" onAction="#onAllRequests" contentDisplay="RIGHT">
                        <graphic><FontIcon iconLiteral="fth-arrow-right" iconSize="15" styleClass="icon"/></graphic>
                    </Button>
                </VBox>
                <ImageView fitHeight="190" preserveRatio="true" smooth="true">
                    <image><Image url="@../images/mascot.png"/></image>
                    <HBox.margin><Insets top="12"/></HBox.margin>
                </ImageView>
            </HBox>

            <!-- Carte profil -->
            <VBox styleClass="card" spacing="12" minWidth="300" maxWidth="340">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Mon profil" styleClass="h3"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox fx:id="nameRow" alignment="CENTER_RIGHT"/>
                </HBox>
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <StackPane fx:id="avatarBox"/>
                    <VBox spacing="4">
                        <Label fx:id="nameLabel" styleClass="semibold" style="-fx-font-size: 16px;" wrapText="true"/>
                        <Label fx:id="tradeLabel" styleClass="trade-label"/>
                        <HBox fx:id="ratingBox"/>
                    </VBox>
                </HBox>
                <HBox spacing="8">
                    <Button text="Profil public" styleClass="btn-secondary,btn-small" onAction="#onPublicProfile">
                        <graphic><FontIcon iconLiteral="fth-eye" iconSize="14" styleClass="icon"/></graphic>
                    </Button>
                    <Button text="Modifier" styleClass="btn-ghost,btn-small" onAction="#onEditProfile">
                        <graphic><FontIcon iconLiteral="fth-edit-2" iconSize="14" styleClass="icon"/></graphic>
                    </Button>
                </HBox>
            </VBox>
        </HBox>

        <HBox fx:id="statsBox" spacing="18"/>

        <HBox spacing="22">
            <VBox styleClass="card" spacing="14" HBox.hgrow="ALWAYS" prefWidth="640">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Demandes reçues" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Hyperlink text="Voir tout" styleClass="link" onAction="#onAllRequests" contentDisplay="RIGHT">
                        <graphic><FontIcon iconLiteral="fth-arrow-right" iconSize="14" styleClass="icon"/></graphic>
                    </Hyperlink>
                </HBox>
                <VBox fx:id="requestsBox" spacing="10"/>
            </VBox>

            <VBox styleClass="card" spacing="14" HBox.hgrow="ALWAYS" prefWidth="380" minWidth="330">
                <Label text="Prochaines interventions" styleClass="section-title"/>
                <VBox fx:id="appointmentsBox" spacing="10"/>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
