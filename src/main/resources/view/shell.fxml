<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Coque de l'espace connecté : menu latéral, barre du haut, zone de contenu.
     Contrôleur : ma.fixi.controller.ShellController -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ma.fixi.controller.ShellController">

    <left>
        <VBox styleClass="sidebar" spacing="6">
            <HBox styleClass="sidebar-logo" alignment="CENTER_LEFT" spacing="12">
                <padding><Insets left="8" bottom="30"/></padding>
                <ImageView fitWidth="44" fitHeight="44" preserveRatio="true" smooth="true">
                    <image><Image url="@../images/logo-white.png"/></image>
                </ImageView>
                <VBox>
                    <Label text="Fixi" styleClass="logo-text"/>
                    <Label text="Connect Maison Facile" styleClass="logo-tagline"/>
                </VBox>
            </HBox>

            <Label fx:id="roleLabel" styleClass="sidebar-role">
                <VBox.margin><Insets bottom="6"/></VBox.margin>
            </Label>
            <VBox fx:id="navBox" spacing="6"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Se déconnecter" styleClass="btn-logout" maxWidth="Infinity" alignment="CENTER_LEFT"
                    onAction="#onLogout">
                <graphic><FontIcon iconLiteral="fth-log-out" iconSize="17" styleClass="icon"/></graphic>
            </Button>
        </VBox>
    </left>

    <center>
        <VBox>
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="20">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label fx:id="titleLabel" styleClass="page-title"/>
                    <Label fx:id="subtitleLabel" styleClass="page-subtitle" wrapText="true"/>
                </VBox>

                <StackPane fx:id="searchBox">
                    <TextField fx:id="globalSearch" promptText="Rechercher un artisan ou un métier…"
                               styleClass="field-with-icon,search-pill" onAction="#onGlobalSearch"/>
                    <FontIcon iconLiteral="fth-search" iconSize="17" styleClass="icon-muted" mouseTransparent="true"
                              StackPane.alignment="CENTER_LEFT">
                        <StackPane.margin><Insets left="15"/></StackPane.margin>
                    </FontIcon>
                </StackPane>

                <MenuButton fx:id="userMenu" styleClass="user-menu" focusTraversable="true">
                    <items>
                        <MenuItem text="Mon profil" onAction="#onProfile">
                            <graphic><FontIcon iconLiteral="fth-user" iconSize="15" styleClass="icon"/></graphic>
                        </MenuItem>
                        <MenuItem text="Se déconnecter" onAction="#onLogout">
                            <graphic><FontIcon iconLiteral="fth-log-out" iconSize="15" styleClass="icon"/></graphic>
                        </MenuItem>
                    </items>
                </MenuButton>
            </HBox>

            <StackPane fx:id="content" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>
</BorderPane>
